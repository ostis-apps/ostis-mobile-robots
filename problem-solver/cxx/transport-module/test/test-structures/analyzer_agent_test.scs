// Описание маршрута
@route_analyzer = [*
    -> rrel_start_point: ..pointA;;
    -> rrel_end_point: ..pointB;;
    ..pointA => nrel_next_point: ..pointB;;
    ..pointB => nrel_next_point: ..pointA;;
*];;

@route_analyzer <- concept_route;;
@route_analyzer => nrel_min_load_time: [1];; // 1 секунда для теста
@route_analyzer => nrel_max_load_time: [2];;

// Робот
robot_test_analyzer <- concept_mobile_robot;;
nrel_location ~> (robot_test_analyzer => ..pointA);;

// Препятствие на пути к точке B
..obstacle1 <- concept_obstacle;;
nrel_obstacle_position ~> (..obstacle1 => ..pointB);;

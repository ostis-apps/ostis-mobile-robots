// маршрут
@route_example_1 = [*
    -> rrel_start_point: ..pointA;;
    -> rrel_end_point: ..pointB;;

    ..pointA => nrel_next_point: ..point1;;
    ..point1 => nrel_next_point: ..point2;;
    ..point2 => nrel_next_point: ..point3;;
    ..point3 => nrel_next_point: ..point4;;
    ..point4 => nrel_next_point: ..pointB;;
    ..pointB => nrel_next_point: ..point5;;
    ..point5 => nrel_next_point: ..point6;;
    ..point6 => nrel_next_point: ..point7;;
    ..point7 => nrel_next_point: ..pointA;;
    ..storage => nrel_next_point: ..pointA;;
*];;
@route_example_1 <- concept_route;;
@route_example_1 => nrel_min_load_time: [0];;
@route_example_1 => nrel_max_load_time: [4];;
@route_example_1 => nrel_min_unload_time: [0];;
@route_example_1 => nrel_max_unload_time: [4];;

// роботы
robot1
<- concept_mobile_robot;;
nrel_location ~> (robot1 => ..storage);;
robot1 => nrel_robot_max_speed: [75];;

robot2
<- concept_mobile_robot;;
nrel_location ~> (robot2 => ..storage);;
robot2 => nrel_robot_max_speed: [60];;

robot3
<- concept_mobile_robot;;
nrel_location ~> (robot3 => ..storage);;
robot3 => nrel_robot_max_speed: [50];;

robot4
<- concept_mobile_robot;;
nrel_location ~> (robot4 => ..storage);;
robot4 => nrel_robot_max_speed: [30];;


robot5
<- concept_mobile_robot;;
nrel_location ~> (robot5 => ..storage);;
robot5 => nrel_robot_max_speed: [30];;

robot6
<- concept_mobile_robot;;
nrel_location ~> (robot6 => ..storage);;
robot6 => nrel_robot_max_speed: [55];;

// коробки
..box1
<- concept_box;;
nrel_location ~> (..box1 => ..pointA);;

..box2
<- concept_box;;
nrel_location ~> (..box2 => ..pointA);;

..box3
<- concept_box;;
nrel_location ~> (..box3 => ..pointA);;

..box4
<- concept_box;;
nrel_location ~> (..box4 => ..pointA);;

@route_example_1 => nrel_work_robot_group: {
   robot1;
   robot2;
   robot3;
   robot4;
   robot5;
   robot6
};;

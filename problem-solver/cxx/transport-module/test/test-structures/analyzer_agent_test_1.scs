// Короткий кольцевой маршрут
@route_beta = [*
    -> rrel_start_point: ..loc1;;
    -> rrel_end_point: ..loc3;;

    ..loc1 => nrel_next_point: ..loc2;;
    ..loc2 => nrel_next_point: ..loc3;;
    ..loc3 => nrel_next_point: ..loc1;;
    ..base => nrel_next_point: ..loc1;;
*];;

@route_beta <- concept_route;;
@route_beta => nrel_min_load_time: [2];;
@route_beta => nrel_max_load_time: [4];;
@route_beta => nrel_min_unload_time: [1];;
@route_beta => nrel_max_unload_time: [3];;

// Три коробки в первой точке
..pkgA <- concept_box;; 
nrel_location ~> (..pkgA => ..loc1);;

..pkgB <- concept_box;; 
nrel_location ~> (..pkgB => ..loc1);;

..pkgC <- concept_box;; 
nrel_location ~> (..pkgC => ..loc1);;

// Робот "
robot_alpha
<- concept_mobile_robot;;

nrel_location ~> (robot_alpha => ..base);;

robot_alpha => nrel_current_route: @route_beta;;
